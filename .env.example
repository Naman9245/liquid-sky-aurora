# Copy to .env and adjust for the restaurant's own setup.
PORT=3000

# Printed onto table-tent QR codes. Must be the address staff and customers
# can actually reach — a LAN IP for in-restaurant use, or a public hostname.
PUBLIC_BASE_URL=http://localhost:3000

# --- Paying by UPI (optional) ---------------------------------------------
# The restaurant's own UPI id. Leave blank and the pay-by-UPI panel simply
# does not appear; customers pay at the counter as before. Never put a
# placeholder here — a wrong id sends a customer's money to a stranger.
UPI_VPA=
UPI_PAYEE_NAME=Hunger House

# --- The review nudge (optional) ------------------------------------------
# Shown once an order is served, next to the name of whoever served it.
# To get this link: open the restaurant on Google Maps, Share, copy the link,
# and find the Place ID, then use:
#   https://search.google.com/local/writereview?placeid=<PLACE_ID>
GOOGLE_REVIEW_URL=

# --- Shown on receipts and kitchen tickets --------------------------------
RESTAURANT_NAME=Hunger House
RESTAURANT_TAGLINE=Multi Cuisine · 24 Hours Service
RESTAURANT_PHONE=88671 69121 / 82966 67709
RESTAURANT_ADDRESS=40, Brundavan Layout, Kempegowda International Airport Road, near Decathlon, Chikkajala, Bengaluru 562157

# --- The menu assistant (optional) -----------------------------------------
# Answers diner questions like "kuch spicy veg suggest karo", grounded in this
# restaurant's own menu. Uses Google's Gemini API. Get a key at
# https://aistudio.google.com/apikey
#
# Leave blank and the ask box simply does not appear.
#
# IMPORTANT: the assistant has no ingredient or allergen data. It is instructed
# never to claim a dish is free of anything, and to send allergy questions to
# your staff. Do not change that instruction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- GST tax invoicing (optional) -------------------------------------------
# Off until GSTIN and GST_RATE are both set. Until then, printed bills say
# plainly that they are not tax invoices, which is the honest state.
#
# GSTIN is your 15-character registration number, e.g. 29ABCDE1234F1Z5.
GSTIN=
#
# Total GST percentage. 5 for a standalone restaurant (charged as 2.5% CGST +
# 2.5% SGST). 18 only if the attached hotel's declared room tariff is 7500 or
# more per night. Confirm with your accountant.
GST_RATE=5
#
# false = your menu prices are before tax and GST is added on top (the usual
#         way, and what the Hunger House board does)
# true  = your menu prices already include GST and it is worked back out
GST_PRICES_INCLUDE_TAX=false
#
# Invoice numbers look like HH/25-26/000042. Change the prefix if you like.
INVOICE_PREFIX=HH
#
# Your registered business name, if it differs from the trading name.
GST_LEGAL_NAME=
GST_PLACE_OF_SUPPLY=Karnataka (29)
